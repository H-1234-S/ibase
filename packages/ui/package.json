    "@types/react-dom": "19.2.5",
    "eslint": "catalog:",
    "tw-animate-css": "^1.4.0",
    "tailwindcss": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
