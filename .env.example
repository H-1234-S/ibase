# Database
POSTGRES_DB=ibase
POSTGRES_USER=ibase
POSTGRES_PASSWORD=ibase_dev
DATABASE_URL=postgresql://ibase:ibase_dev@localhost:5432/ibase
REDIS_URL=redis://localhost:6379
API_PORT=3001

# API and web application
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000
API_BASE_URL=http://localhost:3001
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ISSUER=ibase-api
JWT_AUDIENCE=ibase-web
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
AUTH_SESSION_ABSOLUTE_TTL_SECONDS=2592000
AUTH_SESSION_IDLE_TTL_SECONDS=604800
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_DOMAIN=

# QQ SMTP (use the mailbox SMTP authorization code)
EMAIL_USER=your-qq-mail@qq.com
EMAIL_PASSWORD=replace-with-qq-smtp-authorization-code
EMAIL_FROM=ibase <your-qq-mail@qq.com>

# Authentication rate limits
AUTH_EMAIL_CODE_TTL_SECONDS=300
AUTH_EMAIL_CODE_COOLDOWN_SECONDS=60
AUTH_EMAIL_CODE_MAX_ATTEMPTS=5
AUTH_EMAIL_RATE_LIMIT_PER_HOUR=5
AUTH_IP_EMAIL_RATE_LIMIT_PER_HOUR=20
AUTH_LOGIN_ACCOUNT_LIMIT=10
AUTH_LOGIN_IP_LIMIT=30
AUTH_LOGIN_HASH_CONCURRENCY=4

# Organization invitations (use an independent secret of at least 32 bytes)
INVITATION_TOKEN_SECRET=replace-with-at-least-32-random-bytes
INVITATION_TTL_HOURS=168
